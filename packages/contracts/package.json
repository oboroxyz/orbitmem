{
  "name": "@orbitmem/contracts",
  "version": "0.1.0",
  "description": "Solidity smart contracts for OrbitMem — on-chain data discovery and reputation (ERC-8004)",
  "type": "module",
  "license": "MIT",
  "author": "Oboro Inc. <dev@oboro.xyz> (https://oboro.xyz)",
  "homepage": "https://github.com/oboroxyz/orbitmem/tree/main/packages/contracts",
  "keywords": ["solidity", "erc-8004", "data-registry", "reputation", "web3", "orbitmem"],
  "repository": {
    "type": "git",
    "url": "https://github.com/oboroxyz/orbitmem",
    "directory": "packages/contracts"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "bun": "./abi/index.ts",
      "import": "./dist/index.js",
      "types": "./abi/index.ts"
    }
  },
  "files": [
    "abi",
    "dist"
  ],
  "scripts": {
    "build": "forge build && bash scripts/generate-abi.sh && bunx tsc -p tsconfig.build.json",
    "build:abi": "bunx tsc -p tsconfig.build.json",
    "test": "forge test -vvv",
    "test:gas": "forge test --gas-report",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
